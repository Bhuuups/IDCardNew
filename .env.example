# Copy to .env (or set these in your hosting dashboard)
DEBUG=1
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=
# Production database, e.g. postgres://user:pass@host:5432/dbname (leave empty for local SQLite)
DATABASE_URL=
# Where photos and templates are stored on disk (use a persistent disk in production)
MEDIA_ROOT=
# Email (for login OTP). Leave EMAIL_HOST empty in development: codes print in the terminal.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=ID Card Desk <no-reply@example.com>
# Parent SMS OTP: dotted path of a function f(mobile, code). Empty = codes only logged / shown in DEBUG
SMS_SENDER=
# Optional TTF font file for non-English names on cards (see README)
CARD_FONT=
